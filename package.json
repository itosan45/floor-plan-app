{
  "name": "floor-plan-editor-app",
  "version": "1.1.4",
  "description": "住宅平面図をアップロードし、マーカーを配置して図面を作成、JPEG画像としてエクスポートできるアプリケーションです。",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "vite --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "apk:debug": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.3.0",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "^8.3.0",
    "@google/genai": "^1.42.0",
    "express": "^4.19.2",
    "html2canvas": "^1.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/html2canvas": "^0.5.35",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "vite": "^7.3.1"
  },
  "keywords": [
    "react",
    "typescript",
    "floor-plan",
    "editor",
    "jpeg"
  ],
  "author": "",
  "license": "UNLICENSED"
}
